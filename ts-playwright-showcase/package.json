{
  "name": "playwright-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "A worked example per Playwright capability, against a self-hosted fixture application",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "playwright test --project=chromium",
    "test:all-browsers": "playwright test",
    "test:ui": "playwright test --project=chromium --ui",
    "fixtures-app": "node fixtures-app/server.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.1.2",
    "allure-playwright": "~3.11.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}

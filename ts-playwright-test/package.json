{
  "name": "saucedemo-ts-playwright-test",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript UI test automation for saucedemo.com - Playwright Test (native runner, no BDD layer)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:all-browsers": "playwright test",
    "test:ui": "playwright test --project=chromium --ui",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.1.2",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}

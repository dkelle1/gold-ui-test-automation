<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- System under test: ASP.NET Core Web API on EF Core with the SQL Server provider, so the
         integration tests exercise the real provider against a real SQL Server (in a container),
         not an in-memory fake. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />

    <!-- Test SDK: the host every runner (xUnit and NUnit alike) plugs into for `dotnet test`. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />

    <!-- xUnit: the runner for the OrderService unit tests and all integration tests. Classic xUnit v2;
         runner.visualstudio is pinned to the 3.1.x line, which supports xUnit v2 2.9.x (the 4.0 line
         targets xUnit v3). -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- NUnit: the runner for the pricing/validation unit tests - the same stack lists both runners,
         so both are demonstrated on genuinely different slices rather than duplicated. -->
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />

    <!-- Mocking: NSubstitute, used from both runners to isolate the service from its repositories/clock. -->
    <PackageVersion Include="NSubstitute" Version="6.2.0" />

    <!-- Integration-test infrastructure. -->
    <!-- Testcontainers.MsSql: spins up a throwaway SQL Server container per test run. -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <!-- Respawn: fast, targeted database reset between integration tests (delete data, keep schema). -->
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <!-- WebApplicationFactory<Program>: boots the real API in-process for full-stack HTTP tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Microsoft.Data.SqlClient (the type Respawn opens a connection with) is intentionally NOT pinned
         here: it flows in transitively from Microsoft.EntityFrameworkCore.SqlServer, so letting EF Core
         choose its matching version avoids a central-package-management version conflict. -->
  </ItemGroup>

</Project>

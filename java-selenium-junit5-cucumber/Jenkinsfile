// Secondary CI option (GitHub Actions is primary - see .github/workflows/java-selenium-junit5-cucumber.yml).
//
// The maven:3.9-eclipse-temurin-21 image has no browser installed, so Selenium Manager can't resolve a
// local Chrome (the same situation the other Selenium siblings' Jenkinsfiles document). Rather than
// baking Chrome into a custom agent image, this pipeline runs Chrome as a selenium/standalone-chrome
// sidecar container and points the tests at it via REMOTE_URL (drivers/WebDriverFactory.java already
// supports a remote WebDriver endpoint - no code changes needed). Both containers use `--network host`
// so the maven container can reach the sidecar via localhost.
//
// This requires more than "Docker is available to Jenkins": the 'Start Selenium Grid' stage below runs
// `docker` FROM INSIDE the maven agent container, which has no docker CLI baked in. Either (a) use a
// custom agent image that extends maven:3.9-eclipse-temurin-21 with the docker CLI installed and the
// host's docker socket mounted (Docker-outside-of-Docker), or (b) replace the sidecar stage with a
// pre-provisioned Selenium Grid / selenium/standalone-chrome instance reachable at a fixed URL, and just
// set REMOTE_URL to that instead. As shipped, this Jenkinsfile documents the intended shape of a
// Docker-based pipeline rather than being turnkey on every Jenkins install - adjust the sidecar stage to
// match your actual agent setup.
pipeline {
    agent {
        docker {
            image 'maven:3.9-eclipse-temurin-21'
            // -v caches the Maven repository across builds; without it every build re-downloads the
            // whole dependency tree into a fresh container layer.
            args '--network host -v $HOME/.m2:/root/.m2'
        }
    }

    parameters {
        string(name: 'WORKERS', defaultValue: '3', description: 'Cucumber parallel scenario count (must not exceed the 3-account user pool)')
        string(name: 'TAG_FILTER', defaultValue: '', description: "Cucumber tag expression, e.g. @smoke or 'not @known-issue' (blank = all)")
    }

    environment {
        CI = 'true'
        BASE_URL = 'https://www.saucedemo.com/'
        REMOTE_URL = 'http://localhost:4444/wd/hub'
        SELENIUM_CONTAINER = "selenium-grid-${env.BUILD_TAG}"
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Start Selenium Grid') {
            steps {
                sh """
                    docker run -d --name ${SELENIUM_CONTAINER} --network host --shm-size=2g selenium/standalone-chrome:latest
                    for i in \$(seq 1 30); do
                        curl -sf http://localhost:4444/wd/hub/status && break
                        sleep 2
                    done
                """
            }
        }

        stage('Compile') {
            steps {
                dir('java-selenium-junit5-cucumber') {
                    sh 'mvn -B --no-transfer-progress test-compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('java-selenium-junit5-cucumber') {
                    script {
                        def tagArg = params.TAG_FILTER?.trim() ? "-Dcucumber.filter.tags='${params.TAG_FILTER}'" : ''
                        sh """
                            mvn -B --no-transfer-progress test \
                              -Dcucumber.execution.parallel.config.fixed.parallelism=${params.WORKERS} \
                              ${tagArg}
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            dir('java-selenium-junit5-cucumber') {
                junit testResults: 'target/surefire-reports/TEST-*.xml', allowEmptyResults: true
                allure([
                    includeProperties: false,
                    jdk: '',
                    results: [[path: 'allure-results']]
                ])
                archiveArtifacts artifacts: 'target/surefire-reports/**, allure-results/**', allowEmptyArchive: true
            }
            sh "docker rm -f ${SELENIUM_CONTAINER} || true"
        }
    }
}
